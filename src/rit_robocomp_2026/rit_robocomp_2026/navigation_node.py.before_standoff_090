        self.declare_parameter('shelf_standoff_distance', 0.65)
        self.declare_parameter('bin_standoff_distance', 0.65)
        self.declare_parameter('minimum_target_distance', 0.50)
        self.declare_parameter('obstacle_stop_distance', 0.30)
        self.declare_parameter('target_timeout', 0.75)
        self.declare_parameter('target_acquisition_timeout', 2.0)
        self.declare_parameter('approach_target_acquisition_timeout', 8.0)
        self.declare_parameter('book_center_min', 280)
        self.declare_parameter('book_center_max', 360)
        self.declare_parameter('book_bbox_stop_height', 0)
        self.declare_parameter('book_head_down_y', 300)
        self.declare_parameter('book_head_down_pitch', -0.4)
        self.declare_parameter('search_angular_speed', -0.15)

