def vector_values(text, default):
    if not text:
        return np.array(default, dtype=float)
    return np.array([float(value) for value in text.split()], dtype=float)


def rotation_from_rpy(roll, pitch, yaw):
    cr, sr = math.cos(roll), math.sin(roll)
    cp, sp = math.cos(pitch), math.sin(pitch)
    cy, sy = math.cos(yaw), math.sin(yaw)
    rx = np.array([[1, 0, 0], [0, cr, -sr], [0, sr, cr]])
    ry = np.array([[cp, 0, sp], [0, 1, 0], [-sp, 0, cp]])
    rz = np.array([[cy, -sy, 0], [sy, cy, 0], [0, 0, 1]])
    return rz @ ry @ rx


def axis_angle_rotation(axis, angle):
    axis = np.asarray(axis, dtype=float)
    axis /= np.linalg.norm(axis)
    x, y, z = axis
    c, s = math.cos(angle), math.sin(angle)
    one_minus_c = 1.0 - c
    return np.array([
        [c + x * x * one_minus_c,
         x * y * one_minus_c - z * s,
         x * z * one_minus_c + y * s],
        [y * x * one_minus_c + z * s,
         c + y * y * one_minus_c,
         y * z * one_minus_c - x * s],
        [z * x * one_minus_c - y * s,
         z * y * one_minus_c + x * s,
         c + z * z * one_minus_c],
    ])


def matrix_transform(rotation=None, translation=None):
    result = np.eye(4)
    if rotation is not None:
        result[:3, :3] = rotation
    if translation is not None:
        result[:3, 3] = translation
    return result


def rotation_vector(rotation):
    cosine = np.clip((np.trace(rotation) - 1.0) / 2.0, -1.0, 1.0)
    angle = math.acos(cosine)
    if angle < 1e-9:
        return np.zeros(3)
    if abs(math.pi - angle) < 1e-5:
        eigenvalues, eigenvectors = np.linalg.eig(rotation)
        axis = np.real(eigenvectors[:, np.argmin(abs(eigenvalues - 1.0))])
        axis /= np.linalg.norm(axis)
        return axis * angle
    axis = np.array([
        rotation[2, 1] - rotation[1, 2],
        rotation[0, 2] - rotation[2, 0],
        rotation[1, 0] - rotation[0, 1],
    ]) / (2.0 * math.sin(angle))
    return axis * angle


class JointDescription:
    def __init__(self, element):
        self.name = element.attrib['name']
        self.joint_type = element.attrib['type']
        self.parent = element.find('parent').attrib['link']
        self.child = element.find('child').attrib['link']

        origin = element.find('origin')
        xyz = vector_values(
            origin.attrib.get('xyz') if origin is not None else None,
            [0, 0, 0],
        )
        rpy = vector_values(
            origin.attrib.get('rpy') if origin is not None else None,
            [0, 0, 0],
        )
        self.origin = matrix_transform(rotation_from_rpy(*rpy), xyz)

        axis = element.find('axis')
        self.axis = vector_values(
            axis.attrib.get('xyz') if axis is not None else None,
            [1, 0, 0],
        )

        limit = element.find('limit')
        if self.joint_type == 'continuous':
            self.lower, self.upper = -math.pi, math.pi
        elif limit is not None and 'lower' in limit.attrib and 'upper' in limit.attrib:
            self.lower = float(limit.attrib['lower'])
            self.upper = float(limit.attrib['upper'])
        else:
            self.lower, self.upper = 0.0, 0.0

    @property
    def movable(self):
        return self.joint_type in ('revolute', 'continuous', 'prismatic')

    def motion(self, position):
        if self.joint_type in ('revolute', 'continuous'):
            return matrix_transform(
                rotation=axis_angle_rotation(self.axis, position)
            )
        if self.joint_type == 'prismatic':
            return matrix_transform(translation=self.axis * position)
        return np.eye(4)


def load_chain(path, base_link, tip_link):
    root = ET.parse(path).getroot()
    joint_by_child = {
        element.find('child').attrib['link']: JointDescription(element)
        for element in root.findall('joint')
    }
    reversed_chain = []
    link = tip_link
    while link != base_link:
        joint = joint_by_child.get(link)
        if joint is None:
            raise RuntimeError(
                f'No URDF chain from {base_link} to {tip_link}; stopped at {link}'
            )
        reversed_chain.append(joint)
        link = joint.parent
    return list(reversed(reversed_chain))


def forward_kinematics(chain, positions):
    result = np.eye(4)
    for joint in chain:
        result = result @ joint.origin
        if joint.movable:
            result = result @ joint.motion(positions[joint.name])
    return result


def numerical_jacobian(chain, positions, movable_names, current_pose):
    epsilon = 1e-6
    jacobian = np.zeros((6, len(movable_names)))
    for column, name in enumerate(movable_names):
        shifted = dict(positions)
        shifted[name] += epsilon
        shifted_pose = forward_kinematics(chain, shifted)
        jacobian[:3, column] = (
            shifted_pose[:3, 3] - current_pose[:3, 3]
        ) / epsilon
        delta_rotation = shifted_pose[:3, :3] @ current_pose[:3, :3].T
        jacobian[3:, column] = rotation_vector(delta_rotation) / epsilon
    return jacobian


def solve_ik(chain, seed, target, lower, upper, movable_names):
    positions = dict(seed)
    damping = 0.03
    for iteration in range(250):
        current = forward_kinematics(chain, positions)
        position_error = target[:3, 3] - current[:3, 3]
        orientation_error = rotation_vector(
            target[:3, :3] @ current[:3, :3].T
        )
        error = np.concatenate((position_error, orientation_error))
        if (
            np.linalg.norm(position_error) < 5e-4
            and np.linalg.norm(orientation_error) < 2e-3
        ):
            return True, positions, iteration, position_error, orientation_error

        jacobian = numerical_jacobian(
            chain, positions, movable_names, current
        )
        system = jacobian @ jacobian.T + (damping ** 2) * np.eye(6)
        step = jacobian.T @ np.linalg.solve(system, error)
        largest = np.max(np.abs(step))
        if largest > 0.08:
            step *= 0.08 / largest

        for index, name in enumerate(movable_names):
            positions[name] = float(np.clip(
                positions[name] + step[index], lower[index], upper[index]
            ))

    current = forward_kinematics(chain, positions)
    return (
        False,
        positions,
        250,
        target[:3, 3] - current[:3, 3],
        rotation_vector(target[:3, :3] @ current[:3, :3].T),
    )


